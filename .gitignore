# Laravel/Node dependency lock files MUST be tracked — a fresh clone
# without composer.lock falls back to `composer update`, which fails on
# Packagist security advisories and breaks container builds.
!composer.lock
!package-lock.json
.DS_Store
Thumbs.db
/.phpunit.cache/
.env.local
.env.testing
.env.testing.*.local

# Scratch / debug files (Phase 0 of repo restructure)
/.tmp_*.php
/debug_*.php
/test_*.php
/.env*.backup

# Codegen output for php artisan inertia:dump-types
resources/js/shared/lib/inertia.generated.ts

# TypeScript build artefacts (Pass 5 hygiene fix)
#
# This repo is type-checked, never emitted: `npm run check` (svelte-check)
# owns type checking and Vite owns the build. tsconfig.json sets
# noEmit, and tsconfig.node.json parks its declaration output in
# node_modules/.tmp — so nothing below should ever be generated.
#
# These entries are a BACKSTOP, not a licence: if any of them reappear in
# `git status`, something is running `tsc` with emit enabled instead of
# using `npm run check`, and that needs fixing rather than ignoring.
*.tsbuildinfo
/vite.config.js
/vite.config.d.ts
/resources/js/**/*.js
/resources/js/**/*.js.map
