APP_NAME="Temple Trust"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=temple_trust
DB_USERNAME=temple_trust
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3
REDIS_USERNAME=
REDIS_TIMEOUT=1.5
REDIS_READ_TIMEOUT=0.5
REDIS_QUEUE_TIMEOUT=5
REDIS_QUEUE_READ_TIMEOUT=30
REDIS_PERSISTENT=false
REDIS_PREFIX=temple_trust_

# Optional: full DSN (overrides host/port/password/db above)
# Format: redis://[username]:[password]@[host]:[port]/[db]
# Example for managed Redis (Upstash/Redis Cloud/Aiven):
# REDIS_URL=rediss://default:***@example.upstash.io:6379/0
# REDIS_URL=

# Neon PostgreSQL — production connection (replace with your actual branch endpoint)
# Format: postgresql://USERNAME:PASSWORD@HOST/DB?sslmode=require&channel_binding=require
# DATABASE_URL=postgresql://neondb_owner:secret@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# SSL mode override for the `pgsql` connection block.
# - Local Docker Postgres: leave unset (driver default; no TLS)
# - Hosted Postgres / staging: 'require'
# - Production: 'require' minimum; 'verify-full' if you have a CA bundle
# Note: the `neon` connection block always forces sslmode=require regardless.
DB_SSLMODE=

# Razorpay — Primary Payment Gateway (India)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# PayPal — Secondary Payment Gateway (International)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# Neon
NEON_BRANCH=main
NEON_ROLE=app

# Email
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@templetrust.org
MAIL_FROM_NAME=Temple Trust

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync
