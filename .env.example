## ── Application ───────────────────────────────────────────────────────
APP_NAME="Temple Trust"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

## ── Database (Neon in production, postgres or sqlite in local) ────────
DB_CONNECTION=neon
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_DATABASE=temple_trust
DB_USERNAME=temple_trust
DB_PASSWORD=
DB_SSLMODE=require

## ── Neon-specific ──────────────────────────────────────────────────────
NEON_BRANCH=main
NEON_ROLE=neondb_owner

## ── Cache / Queue / Session ────────────────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CLIENT=phpredis
REDIS_PREFIX=temple_trust
REDIS_DB=0
REDIS_PASSWORD=dev

SESSION_DRIVER=file
SESSION_LIFETIME=120

## ── Razorpay (sole public gateway for the Indian launch) ──────────────
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

## ── PayPal (opt-in; leave PAYPAL_ENABLED=false for launch) ────────────
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

## ── Mail (set MAIL_MAILER=smtp with real provider before launch) ─────
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="receipts@temple.example.in"
MAIL_FROM_NAME="${APP_NAME}"

## ── Admin Kernel (single canonical admin) ──────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

## ── Queue tuning ──────────────────────────────────────────────────────
QUEUE_GENERAL_TRIES=3
QUEUE_GENERAL_BACKOFF=10,60,300
QUEUE_FINANCIAL_TRIES=1
QUEUE_FINANCIAL_BACKOFF=0
QUEUE_WORKER_MAX_TIME=3600
QUEUE_WORKER_SLEEP=3
QUEUE_WORKER_TIMEOUT=60
QUEUE_FAILED_RETENTION_HOURS=720
