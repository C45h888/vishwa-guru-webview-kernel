## ── Application ───────────────────────────────────────────────────────
APP_NAME="Temple Trust"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://vsrsms.in


## ── Database (Neon in production, postgres or sqlite in local) ────────
DB_CONNECTION=neon
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_DATABASE=temple_trust
DB_USERNAME=temple_trust
DB_PASSWORD=
DB_SSLMODE=require

## ── Neon-specific ──────────────────────────────────────────────────────
NEON_BRANCH=main
NEON_ROLE=neondb_owner

## ── Cache / Queue / Session ────────────────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CLIENT=phpredis
REDIS_PREFIX=temple_trust
REDIS_DB=0
REDIS_PASSWORD=dev

SESSION_DRIVER=file
SESSION_LIFETIME=120

## ── Razorpay (sole public gateway for the Indian launch) ──────────────
RAZORPAY_MODE=test
RAZORPAY_ENABLED=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_HEADER=X-Razorpay-Signature
RAZORPAY_WEBHOOK_TOLERANCE=300

## ── Receipt Generation ────────────────────────────────────────────────
RECEIPTS_ENABLED=true
RECEIPTS_STORAGE_DISK=local
RECEIPTS_STORAGE_PATH_TEMPLATE=receipts/{year}/{receipt_number}.pdf
RECEIPT_FORM10BD_MIN_AMOUNT=5000

## ── 80G Certificate (Income Tax Act 1961 §80G) ───────────────────────
## Set TRUST_80G_REGISTERED=true once the trust has obtained 80G
## registration. Receipts will then carry a certificate number on
## donations above RECEIPT_80G_THRESHOLD_MINOR (default ₹500).
TRUST_80G_REGISTERED=false
RECEIPT_80G_THRESHOLD_MINOR=50000
## NOTE: statutory donee credentials (PAN, TAN, 80G + 12A numbers) live
## EXCLUSIVELY in the DB plane (trust_identities, key=canonical). There
## are deliberately no TRUST_* env keys for them — never add any.

## ── PayPal (opt-in; leave PAYPAL_ENABLED=false for launch) ────────────
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

## ── Mail (set MAIL_MAILER=smtp with real provider before launch) ─────
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="sriramguruji@vsrsms.in"
MAIL_FROM_NAME="${APP_NAME}"

## ── Admin Kernel (single canonical admin) ──────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

## ── Queue tuning ──────────────────────────────────────────────────────
QUEUE_GENERAL_TRIES=3
QUEUE_GENERAL_BACKOFF=10,60,300
QUEUE_FINANCIAL_TRIES=1
QUEUE_FINANCIAL_BACKOFF=0
QUEUE_WORKER_MAX_TIME=3600
QUEUE_WORKER_SLEEP=3
QUEUE_WORKER_TIMEOUT=60
QUEUE_FAILED_RETENTION_HOURS=720

## ── Generated-Media pipeline (Flux2 on InvokeAI pod) ────────────────
# Point MEDIA_GENERATION_API_URL at the InvokeAI pod (reachable via
# SSH port-forward: ssh -L 9090:127.0.0.1:9090 root@<pod>).
MEDIA_GENERATION_ENABLED=false
MEDIA_GENERATION_API_URL=http://127.0.0.1:9090
MEDIA_GENERATION_QUEUE=default
MEDIA_GENERATION_POLL_TIMEOUT=180

## ── Public trust identity (config/trust.php) ──
TRUST_EMAIL=sriramguruji@vsrsms.in
TRUST_INSTAGRAM_URL=https://www.instagram.com/vishwagurushishyavrundham.in/
## Optional: only set if the real street address/postcode is confirmed.
TRUST_STREET_ADDRESS=
TRUST_POSTAL_CODE=

## ── Analytics (resources/views/app.blade.php) ──
## Preferred: GTM_ID only, with GA4 + Meta Pixel configured inside GTM.
## GA4_ID / META_PIXEL_ID load directly only when GTM_ID is empty.
GTM_ID=
GA4_ID=
META_PIXEL_ID=
