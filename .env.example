APP_NAME="Temple Trust"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ───────────────────────────────────────────────────────────────────────
# Database connection (canonical: DATABASE_URL)
#
# Laravel reads DATABASE_URL and parses it into the pgsql connection block
# in config/database.php. Every required setting (host, port, database,
# username, password, sslmode, channel_binding) can be expressed in the
# URL — Laravel's PostgresConnector handles it.
#
# Production (Neon): set DATABASE_URL to the pooled connection string
# from the Neon Console. For migrations, switch to the direct endpoint
# (no `-pooler` suffix) to avoid PgBouncer churn on schema apply.
#
# Local dev (Docker Postgres): leave DATABASE_URL empty; the discrete
# DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME keys below take effect.
# ───────────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=temple_trust
DB_USERNAME=temple_trust
DB_PASSWORD=

# Neon connection string — pooled (production runtime).
# Replace with the connection string from Neon Console → Connect.
# Format: postgresql://USER:***@HOST/DB?sslmode=require&channel_binding=require
# DATABASE_URL=postgresql://neondb_owner:npg_***@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Neon connection string — direct (production migrations only).
# Same connection string without the `-pooler` suffix in the hostname.
# DATABASE_URL_DIRECT=postgresql://neondb_owner:npg_***@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3
REDIS_USERNAME=
REDIS_TIMEOUT=1.5
REDIS_READ_TIMEOUT=0.5
REDIS_QUEUE_TIMEOUT=5
REDIS_QUEUE_READ_TIMEOUT=30
REDIS_PERSISTENT=false
REDIS_PREFIX=temple_trust_

# Redis client driver (phpredis extension or predis Composer package).
# Production uses phpredis (faster); predis is the pure-PHP fallback.
REDIS_CLIENT=phpredis
# Redis cluster mode (only set if running a clustered Redis setup).
REDIS_CLUSTER=redis

# Connection-name overrides for cache/queue/session sub-drivers.
# Each maps a Laravel sub-driver to one of the connection names
# defined in config/database.php (default / cache / queue / session).
REDIS_CACHE_LOCK_CONNECTION=default
REDIS_QUEUE_CONNECTION=default

# Optional: full DSN (overrides host/port/password/db above)
# Format: redis://[username]:***@[host]:[port]/[db]
# Example for managed Redis (Upstash/Redis Cloud/Aiven):
# REDIS_URL=rediss://default:***@example.upstash.io:6379/0
# REDIS_URL=

# Razorpay — Primary Payment Gateway (India)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# PayPal — Secondary Payment Gateway (International)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# Neon
NEON_BRANCH=main
NEON_ROLE=app

# Email
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@templetrust.org
MAIL_FROM_NAME=Temple Trust

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Queue worker tuning
QUEUE_GENERAL_TRIES=3
QUEUE_GENERAL_BACKOFF=10,60,300
QUEUE_FINANCIAL_TRIES=1
QUEUE_FINANCIAL_BACKOFF=0
QUEUE_WORKER_MAX_TIME=3600
QUEUE_WORKER_SLEEP=3
QUEUE_WORKER_TIMEOUT=60
QUEUE_FAILED_RETENTION_HOURS=720

# Receipts — kill-switch for ReceiptRenderer in ReceiptService::issue().
# When false, no PDF rendering occurs and no file_assets are written.
RECEIPTS_ENABLED=true

# Inbound HTTP idempotency (Layer 1 of 3-layer dedupe).
# The `Idempotency-Key` header is read on mutating HTTP requests;
# duplicate requests within the TTL window return the cached response.
# Doctrine: SETEX fast-path; DB UNIQUE constraint on idempotency_keys is
# the source of truth; never throws on Redis-down (fail-open).
IDEMPOTENCY_KEY_HEADER=Idempotency-Key
IDEMPOTENCY_TTL_DONATION=86400      # 24h — donation POST requests
IDEMPOTENCY_TTL_WEBHOOK=604800      # 7d  — webhook processing (Layer 3)
