<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         processIsolation="false"
         stopOnFailure="false"
         cacheDirectory=".phpunit.cache"
         backupStaticProperties="false"
         backupGlobals="false">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            All test env values set force="true" so they override the
            container-level DB_CONNECTION=neon / DATABASE_URL inherited
            from docker-compose.yml. Without force="true", phpunit
            silently leaves the existing values in place and the test
            suite attempts to migrate Neon instead of in-memory SQLite.

            We declare each test-relevant value TWICE: once as <env>
            (sets $_ENV and putenv) and once as <server> (sets $_SERVER).
            Phpdotenv's default RepositoryBuilder reads from BOTH $_ENV
            and $_SERVER via ServerConstAdapter / EnvConstAdapter — so
            both must agree on the value, otherwise Laravel's env() falls
            back to whatever was set in $_SERVER by the container env
            (which means Neon would still win).

            Override DB_CONNECTION to sqlite + DB_DATABASE to :memory:
            so RefreshDatabase runs against an in-memory SQLite. Override
            DATABASE_URL to empty so the pgsql connection block does not
            pick up the Neon URL when invoked with DB_CONNECTION=pgsql.
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <server name="APP_ENV" value="testing" force="true"/>

        <env name="APP_URL" value="http://localhost" force="true"/>
        <server name="APP_URL" value="http://localhost" force="true"/>

        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <server name="DB_CONNECTION" value="sqlite" force="true"/>

        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <server name="DB_DATABASE" value=":memory:" force="true"/>

        <env name="DATABASE_URL" value="" force="true"/>
        <server name="DATABASE_URL" value="" force="true"/>

        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="SHARED_IDENTIFIER_STRATEGY" value="ulid" force="true"/>
        <env name="SHARED_DEFAULT_CURRENCY" value="INR" force="true"/>
        <env name="SHARED_CLOCK_IMPLEMENTATION" value="system" force="true"/>
    </php>
</phpunit>