# =====================================================================
# .env.local — canonical LOCAL DEVELOPMENT + TEST-RUNNER config
# =====================================================================
# Single source of truth for local dev + tests.
# Dev server (artisan serve): reads .env + .env.local
# phpunit: reads .env + .env.local + phpunit.xml <env> tags
# IMPORTANT: This file is gitignored. Never commit real credentials.
# =====================================================================

# === App ===
APP_NAME="SRI VISHWAGURU SRI SRI SRIRAM SHISHYAVRUNDHAM MAHASAMSTHANAM"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# === Database ===
DB_CONNECTION=neon
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=
DB_SSLMODE=require

# === Neon PostgreSQL — production connection ===
# Pooled endpoint (-pooler) used for runtime; direct endpoint (no -pooler)
# used for migrations to avoid PgBouncer churn.
DATABASE_URL=
NEON_ROLE=app

# === Redis ===
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3
REDIS_USERNAME=
REDIS_TIMEOUT=1.5
REDIS_READ_TIMEOUT=0.5
REDIS_QUEUE_TIMEOUT=5
REDIS_QUEUE_READ_TIMEOUT=30
REDIS_PERSISTENT=false
REDIS_PREFIX=temple_trust_
REDIS_CLIENT=phpredis
REDIS_CLUSTER=redis
REDIS_CACHE_LOCK_CONNECTION=default
REDIS_QUEUE_CONNECTION=default

# === Razorpay — Primary Payment Gateway (India) ===

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=


# === PayPal — Secondary Payment Gateway (International) ===
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# === Email ===
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@templetrust.org
MAIL_FROM_NAME=Temple_Trust

# === Session / Cache / Queue ===
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# === Phase 4: Admin Kernel — canonical admin credentials ===
ADMIN_EMAIL=admin@vishwaguru.local
ADMIN_NAME="Temple Trust Admin"
